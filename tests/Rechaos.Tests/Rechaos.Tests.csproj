<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <!-- Validation builds tests beneath a disposable artifact root, not the repository. Keep the
         single version source beside the test binary so GameVersionTests still verifies the exact
         file MSBuild stamped into every assembly. -->
    <None Include="../../version.txt" Link="version.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The TypeScript source of the two version constants, beside the test binary for the same
         reason. AGENTS.md makes each pair's equality a hard rule and nothing enforced it: the
         protocol pair was covered only indirectly by the path-filtered OnlineSmoke job, and the
         session pair not at all, because the server stores whatever sessionVersion a client sends
         and never compares it to its own. -->
    <None Include="../../multiplayer/packages/contracts/src/protocol.ts"
          Link="contracts-protocol.ts" CopyToOutputDirectory="PreserveNewest" />
    <!-- The build and format entries, for the tests that decode every file a format entry lists
         (OriginalFormatFiles). They name the files and their hashes; the files themselves come
         from GAME_DIR. -->
    <None Include="../../spec/builds/BLD-*.md" LinkBase="spec/builds" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../spec/formats/FMT-*.md" LinkBase="spec/formats" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <ProjectReference Include="../../src/Rechaos.Core/Rechaos.Core.csproj" />
    <ProjectReference Include="../../src/Rechaos.Extractor/Rechaos.Extractor.csproj" />
    <ProjectReference Include="../../src/Rechaos.Game/Rechaos.Game.csproj" />
    <ProjectReference Include="../../src/Rechaos.Multiplayer/Rechaos.Multiplayer.csproj" />
  </ItemGroup>
</Project>
