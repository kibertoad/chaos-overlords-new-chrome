<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The coordination server's turn resolver is a trimmed WebAssembly build of this assembly
         (src/Rechaos.Resolver.Wasm). The analyzers fail the build on anything that would break
         there, such as JSON read through reflection instead of CoreJsonContext. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RefurbishedDinosaurs.Core" Version="$(RefurbishedDinosaursVersion)" />
    <PackageReference Include="RefurbishedDinosaurs.Media.Audio" Version="$(RefurbishedDinosaursVersion)" />
    <EmbeddedResource Include="GameData/original-data.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RefurbishedDinosaurs.Media.Smacker" Version="$(RefurbishedDinosaursVersion)" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>
</Project>
