<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon />
    <AssemblyTitle>Chaos Overlords: New Chrome</AssemblyTitle>
    <Product>Chaos Overlords: New Chrome</Product>
    <Company>kibertoad</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RefurbishedDinosaurs.Core" Version="$(RefurbishedDinosaursVersion)" />
    <ProjectReference Include="../Rechaos.Core/Rechaos.Core.csproj" />
    <ProjectReference Include="../Rechaos.Multiplayer/Rechaos.Multiplayer.csproj" />
    <PackageReference Include="RefurbishedDinosaurs.Media.Playback" Version="$(RefurbishedDinosaursVersion)" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <!-- DPAPI, for sealing the multiplayer membership token in the local recovery file to the
         current user account. Windows only at runtime; MultiplayerRecoveryStore guards the call. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <EmbeddedResource Include="../../assets/clean-room/branding/*.png" LogicalName="Rechaos.Game.Branding.%(Filename)%(Extension)" />
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(IncludeOriginalAssets)' != 'false'" />
  </ItemGroup>
</Project>
