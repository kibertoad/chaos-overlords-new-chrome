<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Chaos Overlords: New Chrome multiplayer client</AssemblyTitle>
    <Product>Chaos Overlords: New Chrome</Product>
    <Company>kibertoad</Company>
    <!-- The coordination server's turn resolver is a trimmed WebAssembly build of this assembly
         (src/Rechaos.Resolver.Wasm). The analyzers fail the build on anything that would break
         there, such as JSON read through reflection instead of WireJsonContext. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rechaos.Core/Rechaos.Core.csproj" />
  </ItemGroup>
</Project>
