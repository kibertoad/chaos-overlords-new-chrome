# This embedded payload has a recorded byte-level provenance hash. Keep its
# checkout bytes identical on Windows, Linux, and macOS.
/src/Rechaos.Core/GameData/original-data.json text eol=lf

# The release process rewrites this file through the GitHub contents API, which
# writes LF. Keeping the checkout bytes identical avoids a line-ending diff.
/version.txt text eol=lf

# Experiment fixtures run close to the repository's tracked-file size limit, which
# Verify-Repository.ps1 measures on the checkout. LF keeps their size the same on
# every platform instead of growing by one byte per line on Windows.
/spec/experiments/*.json text eol=lf

# Git runs hooks with sh, which rejects the carriage returns a CRLF checkout
# would add on Windows.
.githooks/** text eol=lf

# The published standard, methodology and work protocol, copied byte for byte.
/docs/upstream/** -text
