<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- NuGet audit is still enabled, but an unreachable advisory service must
         not prevent an already-restored offline game from launching. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <!-- The SDK normally excludes only the configured output roots.  A validation or CI build
         that redirects BaseIntermediateOutputPath would otherwise glob generated files left in a
         project's conventional obj directory as source, producing duplicate assembly attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Validation creates this per-run root outside the checkout. Keeping every project's
       intermediates and binaries there prevents stale or access-controlled local obj files
       from participating in the build. -->
  <PropertyGroup Condition="'$(ValidationArtifactsRoot)' != ''">
    <BaseIntermediateOutputPath>$(ValidationArtifactsRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ValidationArtifactsRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- One version for every assembly in the repository, taken from the file the release process
       writes. The release workflow puts the requested tag in version.txt, pushes it, and builds
       every installer from that commit, so the version the game shows is the version on the box.
       Directory.Build.targets fails the build when the file is not a single x.y.z line. -->
  <PropertyGroup>
    <GameVersionFile>$(MSBuildThisFileDirectory)version.txt</GameVersionFile>
    <_GameVersionText Condition="Exists('$(GameVersionFile)')"
                      >$([System.IO.File]::ReadAllText('$(GameVersionFile)').Trim())</_GameVersionText>
    <Version Condition="'$(_GameVersionText)' != ''">$(_GameVersionText)</Version>
    <!-- Without this the SDK appends the commit hash, and Windows would show players a product
         version of "0.1.0+1a2b3c..." while the game reported 0.1.0. The release tag already says
         which commit a version was built from. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
