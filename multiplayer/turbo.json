{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:run": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_DATABASE_URL", "REQUIRE_POSTGRES"]
    },
    "db:generate": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@chaos-overlords/resolver#typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "@chaos-overlords/resolver#test:run": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["REQUIRE_RESOLVER", "RESOLVER_TRANSCRIPT", "DOTNET"]
    },
    "@chaos-overlords/node-server#test:run": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_DATABASE_URL", "REQUIRE_POSTGRES", "REQUIRE_RESOLVER"]
    },
    "@chaos-overlords/worker#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
