{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:run": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "db:generate": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@chaos-overlords/worker#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
