{
  "name": "@chaos-overlords/storage",
  "version": "0.9.2",
  "description": "Drizzle schemas and repository implementations of the kernel storage ports: one SQLite dialect shared by better-sqlite3 and Cloudflare D1, and a Postgres dialect.",
  "keywords": [
    "chaos-overlords",
    "multiplayer",
    "game-server",
    "turn-based",
    "drizzle",
    "sqlite",
    "postgres",
    "cloudflare-d1",
    "migrations",
    "repository"
  ],
  "license": "GPL-3.0-only",
  "author": "kibertoad",
  "homepage": "https://github.com/kibertoad/chaos-overlords-new-chrome/tree/main/multiplayer/packages/storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/chaos-overlords-new-chrome.git",
    "directory": "multiplayer/packages/storage"
  },
  "bugs": {
    "url": "https://github.com/kibertoad/chaos-overlords-new-chrome/issues"
  },
  "type": "module",
  "exports": {
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "migrations",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.postgres.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/prepublish.mjs"
  },
  "dependencies": {
    "@chaos-overlords/contracts": "workspace:*",
    "@chaos-overlords/kernel": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@chaos-overlords/conformance": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
