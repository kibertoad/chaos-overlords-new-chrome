{
  "name": "@chaos-overlords/server",
  "version": "0.1.0",
  "description": "The Hono application both runtimes serve: REST intents, the SSE event stream, auth and the error envelope. Takes its ports through a container.",
  "keywords": [
    "chaos-overlords",
    "multiplayer",
    "game-server",
    "turn-based",
    "hono",
    "rest",
    "server-sent-events",
    "sse",
    "http-api"
  ],
  "license": "GPL-3.0-only",
  "author": "kibertoad",
  "homepage": "https://github.com/kibertoad/chaos-overlords-new-chrome/tree/main/multiplayer/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/chaos-overlords-new-chrome.git",
    "directory": "multiplayer/packages/server"
  },
  "bugs": {
    "url": "https://github.com/kibertoad/chaos-overlords-new-chrome/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/prepublish.mjs"
  },
  "dependencies": {
    "@chaos-overlords/bug-reports": "workspace:*",
    "@chaos-overlords/contracts": "workspace:*",
    "@chaos-overlords/kernel": "workspace:*",
    "@toad-contracts/core": "0.4.0",
    "@toad-contracts/hono": "0.3.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@chaos-overlords/conformance": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
