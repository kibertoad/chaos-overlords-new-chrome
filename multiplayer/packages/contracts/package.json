{
  "name": "@chaos-overlords/contracts",
  "version": "0.8.2",
  "description": "Wire contracts shared by the multiplayer server and its clients: valibot request/response schemas, the event union, the error envelope, and one toad-contracts definition per endpoint.",
  "keywords": [
    "chaos-overlords",
    "multiplayer",
    "game-server",
    "turn-based",
    "contracts",
    "valibot",
    "schema",
    "api-contract",
    "typescript"
  ],
  "license": "GPL-3.0-only",
  "author": "kibertoad",
  "homepage": "https://github.com/kibertoad/chaos-overlords-new-chrome/tree/main/multiplayer/packages/contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/chaos-overlords-new-chrome.git",
    "directory": "multiplayer/packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/kibertoad/chaos-overlords-new-chrome/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/prepublish.mjs"
  },
  "dependencies": {
    "@toad-contracts/core": "1.0.0",
    "@toad-contracts/valibot": "1.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
