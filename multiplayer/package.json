{
  "name": "chaos-overlords-multiplayer",
  "private": true,
  "description": "Multiplayer coordination server for Chaos Overlords: New Chrome. Turborepo + pnpm workspace; see README.md.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "codegen": "node scripts/generate-csharp.mjs",
    "codegen:check": "node scripts/generate-csharp.mjs --check",
    "check-versions": "node scripts/check-versions.mjs",
    "current-version": "node scripts/current-version.mjs",
    "next-version": "node scripts/next-version.mjs",
    "pack-release": "node scripts/pack.mjs",
    "release-version": "node scripts/release-version.mjs",
    "set-version": "node scripts/set-version.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "turbo run db:generate",
    "dev:node": "turbo run dev --filter=@chaos-overlords/node-server",
    "dev:worker": "turbo run dev --filter=@chaos-overlords/worker",
    "publish:dry-run": "pnpm publish -r --dry-run --no-git-checks"
  },
  "devDependencies": {
    "@game-infra/valibot-to-csharp": "0.2.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  }
}
